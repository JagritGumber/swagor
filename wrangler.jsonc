{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "selbo",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Static asset bundle generated by `opennextjs-cloudflare build` into
  // .open-next/assets — bound to the Worker as `ASSETS`.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },

  // Self-reference required for Next.js server-action revalidation. Service
  // name must match the top-level "name" field above.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "selbo" }],

  // next/image optimization binding (handles all next/image transforms at the
  // edge). No additional config needed.
  "images": { "binding": "IMAGES" },

  // Cron triggers fire `scheduled()` in custom-worker.ts. Minimum cadence is
  // 1 minute. The handler internally calls /api/watcher/tick which queries
  // selbo_instances where next_watcher_at <= now() and runs the watcher for
  // each. Per-instance cadence is agent-decided (30-600s), not this 1m heartbeat.
  "triggers": { "crons": ["* * * * *"] }

  // R2 bucket for ISR (uncomment when adding incremental cache):
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "selbo-cache" }
  // ]
}
