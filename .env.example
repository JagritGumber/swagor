# =============================================================================
# Database (Drizzle ORM over Supabase Postgres)
# =============================================================================
# Two URLs needed:
#  - DATABASE_URL: pooler (port 6543) used at runtime with prepare:false.
#    Format: postgresql://postgres.<ref>:<password>@aws-X-<region>.pooler.supabase.com:6543/postgres
#  - DIRECT_URL:  direct connection (port 5432) used by drizzle-kit for schema
#    migrations. The pooler can't run migrations because pgbouncer transaction
#    mode breaks drizzle-kit's long-lived sessions.
#    Format: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Find both at: Supabase Dashboard -> Project Settings -> Database -> Connection string
# (toggle dropdown between "Transaction pooler" and "Direct connection")
DATABASE_URL=
DIRECT_URL=

# =============================================================================
# Circle Developer Platform (wallets + smart contract platform on Arc)
# =============================================================================
# Sign up at console.circle.com -> API keys (sandbox tier is free + sufficient)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Set to ARC-TESTNET for the hackathon. Other valid values per Circle SDK:
# ARC, ETH-SEPOLIA, BASE-SEPOLIA, ARB-SEPOLIA, POLY-AMOY, etc.
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# Agent wallet (auto-populated by `bun run generate-wallet` after Circle creds are set)
NEXT_PUBLIC_AGENT_WALLET_ID=
NEXT_PUBLIC_AGENT_WALLET_ADDRESS=

# USDC contract address on the configured chain (Arc testnet for hackathon)
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=

# =============================================================================
# LLM tier 1 — MAIN (swarm + heavy reasoning)
# =============================================================================
# GLM via Zhipu native API, prepaid, OpenAI-compatible.
# Get key at bigmodel.cn -> console -> API keys. Top up Y50-100 covers hackathon.
# Verify exact model IDs in your Zhipu dashboard - marketing names may differ.
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL_HEAVY=glm-4.7-flashx
LLM_MODEL_LIGHT=glm-4-32b-0414-128k

# =============================================================================
# LLM tier 2 — REVIEW (critic + tax-optimizer; cross-vendor for blind-spot diversity)
# =============================================================================
# Audit agents run on a DIFFERENT model family than the swarm so blind spots
# don't correlate. Without this split, the Critic is just GLM rubber-stamping GLM.
# REQUIRED: LLM_REVIEW_MODEL. The API_KEY + BASE_URL pair is optional —
# set BOTH to point at a separate provider, or leave BOTH blank to reuse the
# main `llm` client above (in which case the review model must exist on bigmodel).
LLM_REVIEW_API_KEY=
LLM_REVIEW_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_REVIEW_MODEL=deepseek-ai/DeepSeek-R1

# =============================================================================
# LLM tier 3 — WATCHER (cheap-tier classifier: hold | execute | deliberate)
# =============================================================================
# Runs on adaptive 30-600s cadence, always-on. Classifies each tick without
# executing. Small model is plenty — it just routes to trader vs swarm.
# DeepInfra Llama-3.1-8B Turbo: $0.02 in / $0.03 out per M tokens, sub-second
# TTFT, true parallel concurrency (200 default), no minimum top-up.
# REQUIRED: LLM_WATCHER_MODEL. API_KEY + BASE_URL optional pair — set both for
# a separate provider, leave both blank to fall through to the main `llm` client.
LLM_WATCHER_API_KEY=
LLM_WATCHER_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_WATCHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# =============================================================================
# LLM tier 4 — TRADER (sub-second tactical executor when watcher says `execute`)
# =============================================================================
# Hot path: liquidation protection, stop-loss/take-profit triggers, funding
# rate flips. Cannot wait for swarm deliberation. Needs reasoning capacity +
# fast inference. DeepInfra Mistral-Small-24B: $0.05/$0.08 per M, sub-second.
# Same DeepInfra key/base URL as watcher works (single account, two models).
# REQUIRED: LLM_TRADER_MODEL. API_KEY + BASE_URL optional pair.
LLM_TRADER_API_KEY=
LLM_TRADER_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_TRADER_MODEL=mistralai/Mistral-Small-24B-Instruct-2501

# =============================================================================
# Better Auth (identity + sessions; replaces Supabase Auth)
# =============================================================================
# Generate the secret once with: openssl rand -base64 32
# BETTER_AUTH_URL must be the canonical origin Better Auth issues cookies
# against (e.g. http://localhost:3000 in dev, https://selbo.workers.dev in prod).
# NEXT_PUBLIC_BETTER_AUTH_URL has the same value but is exposed to the client.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# Polar.sh (subscription billing — merchant of record, India-friendly)
# =============================================================================
# Sign up at polar.sh. Polar is MoR — handles VAT/GST/sales tax for you.
# Fees: 4% + $0.40 per transaction. Onboarding goes through Stripe Connect
# Express (India supported via that path).
#
# Setup:
#   1. polar.sh dashboard -> Settings -> Developers -> create Organization
#      Access Token (sandbox + production are isolated; create one per env).
#   2. polar.sh dashboard -> Products -> create one Product per paid tier
#      with monthly recurring pricing. Paste the product IDs below.
#   3. polar.sh dashboard -> Settings -> Webhooks -> add endpoint pointing
#      at https://<your-deploy>.workers.dev/api/polar/webhook
#      Subscribe to: subscription.created, subscription.updated,
#                    subscription.revoked, order.paid
#      Copy the signing secret into POLAR_WEBHOOK_SECRET.
#
# POLAR_ENV controls server selection. "production" hits api.polar.sh;
# anything else hits sandbox-api.polar.sh.
POLAR_ENV=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_BASIC=
POLAR_PRODUCT_PRO=

# =============================================================================
# Cron auth (production only; not needed for `bun run dev`)
# =============================================================================
# Cloudflare Cron Triggers hit /api/watcher/tick with this header. Set via:
#   wrangler secret put CRON_SECRET
# Leave blank locally; the route skips the auth check when CRON_SECRET is unset.
CRON_SECRET=

# =============================================================================
# Notes on what's NOT here
# =============================================================================
# - News source: GDELT 2.0 DOC API is free and key-less.
# - DefiLlama yields API: also key-less.
# - CoinGecko prices: free tier is key-less.
# - OpenAI / Tavily / Vercel / Google OAuth: not used.
