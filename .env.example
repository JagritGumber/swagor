# =============================================================================
# Database (Drizzle ORM over Supabase Postgres)
# =============================================================================
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use URI mode WITH password. Format:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# =============================================================================
# Supabase (auth + realtime; the anon key is safe to expose client-side)
# =============================================================================
# Get from: Supabase Dashboard -> Project Settings -> API
# Note: Supabase renamed "anon key" to "publishable key" in late 2024.
# Paste the *publishable* key value into NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Functionally identical; backwards-compatible with @supabase/ssr.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Circle Developer Platform (wallets + smart contract platform on Arc)
# =============================================================================
# Sign up at console.circle.com -> API keys (sandbox tier is free + sufficient)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Set to ARC-TESTNET for the hackathon. Other valid values per Circle SDK:
# ARC, ETH-SEPOLIA, BASE-SEPOLIA, ARB-SEPOLIA, POLY-AMOY, etc.
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# Agent wallet (auto-populated by `bun run generate-wallet` after Circle creds are set)
NEXT_PUBLIC_AGENT_WALLET_ID=
NEXT_PUBLIC_AGENT_WALLET_ADDRESS=

# USDC contract address on the configured chain (Arc testnet for hackathon)
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=

# =============================================================================
# LLM provider (OpenAI-compatible API; default = GLM / Zhipu)
# =============================================================================
# Default: GLM-4 (Zhipu). Prepaid model = no surprise billing if your key leaks.
# Get key at bigmodel.cn -> API Keys.
LLM_API_KEY=

# Optional overrides (defaults match GLM):
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL_HEAVY=glm-4-plus
# LLM_MODEL_LIGHT=glm-4-flash

# To swap providers, uncomment + adjust:
#   Cerebras:
#     LLM_BASE_URL=https://api.cerebras.ai/v1
#     LLM_MODEL_HEAVY=llama-3.3-70b
#     LLM_MODEL_LIGHT=llama-3.1-8b
#   Groq:
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL_HEAVY=llama-3.3-70b-versatile
#     LLM_MODEL_LIGHT=llama-3.1-8b-instant

# =============================================================================
# Notes on what's NOT here
# =============================================================================
# - News source: we use GDELT 2.0 DOC API which is free and key-less. No env var needed.
# - DefiLlama yields API: also key-less.
# - CoinGecko prices: free tier is key-less.
# - OpenAI / Tavily / Vercel / Google OAuth: not used.
