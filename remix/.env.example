# Required: random string used to sign session cookies
# Generate with: bun -e "import crypto from 'crypto'; console.log(crypto.randomBytes(32).toString('hex'))"
SELBO_SESSION_SECRET=

# Required: Circle SDK credentials for wallet allocation
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Optional: server port (default: 44100)
PORT=44100

# Database driver: "pglite" (dev, default) or "postgres" (production)
DRIZZLE_DRIVER=pglite

# Optional: PostgreSQL connection string (required when DRIZZLE_DRIVER=postgres)
# When DRIZZLE_DRIVER=pglite, this is the path to the PGlite data directory (default: .data/pglite)
DATABASE_URL=

# Supabase PostgreSQL connection string (for judgment queries in the root Supabase DB)
# In production, set to the same value as root app DATABASE_URL
SUPABASE_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
