# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# JetBrains IDE files
/.vscode

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
# Real secrets live in .env.production for Cloudflare/OpenNext prod builds
# (NEXT_PUBLIC_* and runtime keys). NEVER commit; treat as .env.local.
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo

# cloudflare workers + opennext
.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts

# project-specific
references/
.idea/
.claude/

# emails: auto-generated by `bun run emails:build` (prebuild hook on CI)
lib/email/compiled-templates.ts
